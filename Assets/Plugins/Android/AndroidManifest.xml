<?xml version="1.0" encoding="utf-8"?>
<!--
  Explicit PICO VR classification. The SDK build hook normally emits these values,
  but this project uses Unity 6000's Bee/Gradle path where that hook was skipped.
  Keeping them in the source manifest prevents the runtime treating the app as a
  freeform Android panel.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="com.picovr.permission.HAND_TRACKING" />
  <application android:requestLegacyExternalStorage="true">
    <meta-data android:name="pvr.app.type" android:value="vr" />
    <meta-data android:name="pxr.sdk.generation" android:value="4" />
    <meta-data android:name="pxr.sdk.version_code" android:value="6000" />
    <meta-data android:name="use.pxr.sdk" android:value="1" />
    <meta-data android:name="pvr.sdk.version" android:value="Unity_XR_6.0.0" />
    <meta-data android:name="rendering_mode" android:value="1" />
    <meta-data android:name="display_rate" android:value="0" />
    <meta-data android:name="controller" android:value="1" />
    <meta-data android:name="handtracking" android:value="1" />
    <!-- Declaring the launcher here is required when a custom manifest is
         present.  Otherwise Unity 6000's generated launcher entry is replaced
         by XR Management's bare activity declaration, which PICO recognizes as
         VR but Android cannot start from the launcher. -->
    <activity
        android:name="com.unity3d.player.UnityPlayerActivity"
        android:enabled="true"
        android:exported="true"
        android:launchMode="singleTask"
        android:screenOrientation="landscape"
        android:configChanges="fontScale|keyboard|keyboardHidden|locale|mnc|mcc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|touchscreen"
        android:hardwareAccelerated="false"
        android:resizeableActivity="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <meta-data android:name="unityplayer.UnityActivity" android:value="true" />
    </activity>
  </application>
</manifest>
